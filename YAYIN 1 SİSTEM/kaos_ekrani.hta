<!DOCTYPE html>
<html>
<head>
<meta http-equiv="x-ua-compatible" content="ie=9">
<meta charset="utf-8">
<title>HATA</title>
<HTA:APPLICATION
    ID="oKaos"
    APPLICATIONNAME="KaosEkrani"
    SHOWINTASKBAR="no"
    SINGLEINSTANCE="no"
    BORDER="thin"
    BORDERSTYLE="normal"
    CAPTION="yes"
    SYSMENU="yes"
    MAXIMIZEBUTTON="no"
    MINIMIZEBUTTON="no"
    SCROLL="no"
    CONTEXTMENU="no"
    SELECTION="no"
    INNERBORDER="no"
    NAVIGABLE="no"
    WINDOWSTATE="normal">
<style type="text/css">
    html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background-color: #8B0000;
        cursor: default;
    }
    #kutu {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        display: table;
        background-color: #8B0000;
    }
    #yazi {
        display: table-cell;
        vertical-align: middle;
        text-align: center;
        color: #FFD700;
        font-family: "Segoe UI Emoji", "Segoe UI", Arial, sans-serif;
        font-size: 40px;
        font-weight: bold;
        letter-spacing: 1px;
        white-space: nowrap;
    }
</style>

<script language="VBScript">
Option Explicit

' Pencere boyutu (istersen buradan degistir)
Const GENISLIK = 360
Const YUKSEKLIK = 180

Dim konumX, konumY

Sub Duzenle()
    On Error Resume Next
    window.resizeTo GENISLIK, YUKSEKLIK
    window.moveTo konumX, konumY
    Err.Clear
End Sub

Sub OdagiPanele()
    ' Yeni hata penceresi odagi calmasin: odagi hemen panele geri ver
    On Error Resume Next
    Dim sh
    Set sh = CreateObject("WScript.Shell")
    sh.AppActivate "Merkezi Sistem"
    Err.Clear
End Sub

Sub Baslat()
    Dim maxX, maxY

    ' Rastgele konum (Randomize + Rnd)
    Randomize Timer
    maxX = screen.availWidth - GENISLIK
    maxY = screen.availHeight - YUKSEKLIK
    If maxX < 0 Then maxX = 0
    If maxY < 0 Then maxY = 0

    konumX = Int(Rnd * (maxX + 1))
    konumY = Int(Rnd * (maxY + 1))

    Duzenle
    ' Boyut/konum bazen ilk seferde uygulanmaz, tekrar uygula
    window.setTimeout "Duzenle", 30, "VBScript"
    window.setTimeout "Duzenle", 150, "VBScript"
    window.setTimeout "Duzenle", 400, "VBScript"

    ' Odagi panele geri ver
    OdagiPanele
    window.setTimeout "OdagiPanele", 80, "VBScript"
    window.setTimeout "OdagiPanele", 250, "VBScript"
    window.setTimeout "OdagiPanele", 600, "VBScript"
End Sub
</script>
<script language="VBScript" for="window" event="onload">
    Baslat
</script>
</head>

<body>
    <div id="kutu">
        <div id="yazi">&#9888;&#65039; HATA</div>
    </div>
</body>
</html>
